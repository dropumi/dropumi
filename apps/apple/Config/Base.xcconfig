// SPDX-License-Identifier: MPL-2.0
//
// Settings shared by every target of the Dropumi Xcode project.

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 27.0
MACOSX_DEPLOYMENT_TARGET = 27.0

SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES

DEAD_CODE_STRIPPING = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

// arm64 only (ADR-0012): the Rust core has no x86_64 slices.
ARCHS = arm64
EXCLUDED_ARCHS = x86_64

// Automatic signing. The team comes only from the gitignored
// Signing.local.xcconfig (copy Signing.local.xcconfig.example) or from
// the command line (DEVELOPMENT_TEAM=...). CI builds without signing.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
