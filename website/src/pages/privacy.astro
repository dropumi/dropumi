---
import Legal from '../layouts/Legal.astro';
---
<Legal
	title="Privacy"
	sub="dropumi shares files directly between your devices. We do not run servers that see your files."
	updated="2026-10-15"
	sections={[
		['Short version', 'Your files go straight from one device to another over your local network. They are not uploaded to us or to any cloud service, and we do not collect them.'],
		['What stays on your device', 'File names, file contents, device names and transfer history stay on your devices. You can clear the history at any time on the Transfers screen.'],
		['What other people can see', 'While dropumi is receiving, devices on the same network can see your device name, its local network address and a short hint of its fingerprint. Set Who can send to Off in Settings to stop receiving and stop appearing in other people’s lists.'],
		['Accounts and tracking', 'There are no accounts. The app has no ads and no analytics, and it does not track you.'],
		['Website', 'This website does not use tracking cookies. If we add privacy-friendly analytics later, we will say so on this page.'],
		['Changes and contact', 'If this policy changes, we will update this page and the date at the top. Questions can be sent by opening an issue on GitHub.'],
	]}
/>
