---
import Page from '../layouts/Page.astro';
import WifiOff from '@lucide/astro/icons/wifi-off';
import Feather from '@lucide/astro/icons/feather';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Layers from '@lucide/astro/icons/layers';
import Zap from '@lucide/astro/icons/zap';
import CodeXml from '@lucide/astro/icons/code-xml';
import Apple from '@lucide/astro/icons/apple';
import Monitor from '@lucide/astro/icons/monitor';
import Terminal from '@lucide/astro/icons/terminal';
import Smartphone from '@lucide/astro/icons/smartphone';
import Download from '@lucide/astro/icons/download';
import AppMockup from '../components/AppMockup.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const steps = [
	['Open dropumi', 'Both devices just need to be on the same Wi-Fi or hotspot. Nearby devices show up on the radar on their own.'],
	['Pick a file, tap a device', 'Drop a file or photo onto the app, then tap the device you want to send it to.'],
	['Accept and done', 'The other person gets a prompt and accepts. The file goes straight across your local network.'],
];
const features = [
	['Works offline', WifiOff, 'Everything stays on your local network. No internet, no account, no server in the middle.'],
	['Ultra lightweight', Feather, 'A tiny app that starts instantly and sips battery and memory.'],
	['Private by design', ShieldCheck, 'Files go straight from device to device. Nothing is uploaded, stored or tracked.'],
	['Cross-platform', Layers, 'macOS, Windows, Linux, iOS and Android, all talking to each other.'],
	['Fast on your Wi-Fi', Zap, 'Large files move at local network speed, not at your internet speed.'],
	['Free and open source', CodeXml, 'Read the code, fork it, improve it. No ads, no paywall, ever.'],
];
const shareSteps = [
	['share-1-select.png', 'Tap Share', 'Pick a photo, video or any file. Your nearby devices and dropumi appear in the share sheet.', 'The iOS share sheet with nearby devices and dropumi'],
	['share-2-choose.png', 'Choose a device', 'dropumi finds who is close. Tap a device to send, no internet needed.', 'The dropumi sheet showing nearby devices'],
	['share-3-sending.png', 'Watch it land', 'The file goes straight across your Wi-Fi, and you see progress as it sends.', 'A file sending to Maya\'s iPhone with a progress bar'],
];
const platforms = [
	['macOS', Apple, 'Apple silicon and Intel'],
	['Windows', Monitor, 'Windows 10 and 11'],
	['Linux', Terminal, 'AppImage and .deb'],
	['iOS', Smartphone, 'iPhone and iPad'],
	['Android', Smartphone, 'Android 8 and up'],
];
---
<Page title="dropumi">
	<main>
		<section class="hero">
			<span class="badge"><i></i>Free and open source · No internet needed</span>
			<h1>Send anything to anyone nearby.</h1>
			<p class="lead">dropumi is an AirDrop-style way to share files between phones and computers on the same Wi-Fi. No accounts, no cloud, no cables. Just drop.</p>
			<div class="ctas">
				<a class="btn primary" href="#download"><Download size={20} />Download dropumi</a>
				<a class="btn" href="https://github.com/dropumi/dropumi"><svg class="ghi" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>View source</a>
			</div>
			<small>macOS · Windows · Linux · iOS · Android</small>
			<div class="shot"><AppMockup /></div>
		</section>

		<section id="how" class="dark">
			<p class="eyebrow light">HOW IT WORKS</p>
			<h2>Three taps. No setup.</h2>
			<div class="grid3">
				{steps.map(([t, d], i) => (
					<div class="card dark-card"><span class="num">{i + 1}</span><h3>{t}</h3><p>{d}</p></div>
				))}
			</div>
		</section>

		<section id="features">
			<p class="eyebrow">WHY DROPUMI</p>
			<h2>Light on everything except what it can send.</h2>
			<p class="sub">Built to be small, fast and out of your way.</p>
			<div class="grid3">
				{features.map(([t, Icon, d]) => <div class="card"><span class="icon"><Icon size={24} /></span><h3>{t}</h3><p>{d}</p></div>)}
			</div>
		</section>

		<section class="mobile">
			<div class="mtext">
				<p class="eyebrow">ON YOUR PHONE</p>
				<h2>Phone to laptop in a few seconds.</h2>
				<p>See who is nearby, tap a device and send photos, videos and documents. Receiving is one tap, too. Light and dark themes follow your system.</p>
				<ul>
					<li>No account or sign-in</li>
					<li>Works with hotspots and shared Wi-Fi</li>
					<li>Light and dark themes</li>
				</ul>
			</div>
			<div class="phones">
				<img src={`${base}/images/app-mobile-light.png`} alt="dropumi on a phone, light theme" />
				<img class="mid" src={`${base}/images/app-mobile-receive.png`} alt="Receiving a file" />
				<img src={`${base}/images/app-mobile-dark.png`} alt="dropumi on a phone, dark theme" />
			</div>
		</section>

		<section id="share" class="dark">
			<p class="eyebrow light">SHARE FROM ANY APP</p>
			<h2>Select a file. Share it with dropumi.</h2>
			<p class="sub dim">dropumi shows up in the share sheet of your phone, next to the apps you already use.</p>
			<div class="steps3">
				{shareSteps.map(([img, t, d, alt], i) => (
					<figure>
						<img src={`${base}/images/${img}`} alt={alt} loading="lazy" />
						<figcaption><span class="num">{i + 1}</span><strong>{t}</strong><p>{d}</p></figcaption>
					</figure>
				))}
			</div>
		</section>

		<section id="download">
			<p class="eyebrow">DOWNLOAD</p>
			<h2>Get dropumi on every device.</h2>
			<div class="platforms">
				{platforms.map(([n, Icon, s]) => (
					<div class="card plat"><Icon size={30} color="var(--text-primary)" /><h3>{n}</h3><p>{s}</p><a class="btn primary small" href="https://github.com/dropumi/dropumi/releases">Download</a></div>
				))}
			</div>
		</section>

		<section class="dark center">
			<img src={`${base}/images/symbol-reversed.svg`} alt="" width="72" height="72" />
			<h2>Built in the open. Yours to improve.</h2>
			<p class="sub dim">dropumi is free software. Report a bug, suggest a feature, translate the app or send a pull request. Everyone is welcome.</p>
			<div class="ctas">
				<a class="btn teal" href="https://github.com/dropumi/dropumi"><svg class="ghi" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>Star on GitHub</a>
				<a class="btn ghost" href={`${base}/docs/contributing/`}>How to contribute</a>
			</div>
		</section>
	</main>
</Page>

<style>
	section { padding: 110px var(--gutter); display: flex; flex-direction: column; align-items: center; gap: 24px; text-align: center; }
	.hero { padding-top: 56px; gap: 24px; }
	.badge { display: inline-flex; align-items: center; gap: 8px; background: var(--accent-soft); color: var(--accent); font-weight: 600; font-size: 13px; padding: 8px 16px; border-radius: 999px; }
	.badge i { width: 8px; height: 8px; border-radius: 50%; background: var(--success); }
	h1 { font-size: clamp(40px, 6vw, 68px); font-weight: 800; line-height: 1.08; max-width: 820px; }
	h2 { font-size: clamp(30px, 4vw, 44px); font-weight: 800; line-height: 1.12; max-width: 760px; }
	h3 { font-size: 20px; font-weight: 700; }
	.lead, .sub { font-size: 19px; max-width: 620px; margin: 0; }
	.sub { font-size: 17px; max-width: 560px; }
	.ctas { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
	.btn { display: inline-flex; align-items: center; height: 56px; padding: 0 30px; border-radius: 999px; font-weight: 600; font-size: 16px; border: 1px solid var(--border); background: var(--surface); color: var(--text-primary); }
	.btn { gap: 10px; }
	.btn.primary { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
	.btn.small { height: 38px; padding: 0 18px; font-size: 13px; }
	.btn.teal { background: var(--light-teal); color: #06111f; border-color: var(--light-teal); }
	.btn.ghost { background: transparent; color: #f2f7fa; border-color: #3a5573; }
	.shot { width: 100%; max-width: 1000px; margin-top: 32px; }
	.eyebrow { font-size: 13px; font-weight: 700; letter-spacing: 0.12em; color: var(--accent); margin: 0; }
	.eyebrow.light { color: var(--light-teal); }
	.dark { background: var(--navy); }
	.dark h2 { color: #f2f7fa; }
	.dim { color: #9db0c2; }
	.grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; width: 100%; max-width: 1280px; margin-top: 24px; text-align: left; }
	.card { background: var(--surface); border: 1px solid var(--border); border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 12px; }
	.card p { margin: 0; font-size: 15px; }
	.dark-card { background: #0f2238; border-color: #1f3652; }
	.dark-card h3 { color: #f2f7fa; }
	.dark-card p { color: #9db0c2; }
	.icon { width: 52px; height: 52px; border-radius: 16px; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; }
	.num { width: 44px; height: 44px; border-radius: 50%; background: #123a4c; color: var(--light-teal); display: grid; place-items: center; font-weight: 700; }
	.mobile { background: var(--surface); flex-direction: row; justify-content: center; gap: 64px; text-align: left; flex-wrap: wrap; }
	.mtext { max-width: 480px; display: flex; flex-direction: column; gap: 20px; }
	.mtext p { margin: 0; font-size: 17px; }
	.mtext h2 { text-align: left; }
	.mtext ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; color: var(--text-primary); font-weight: 500; }
	.mtext li::before { content: '✓'; color: var(--success); font-weight: 700; margin-right: 10px; }
	.phones { display: flex; gap: 24px; align-items: center; }
	.phones img { width: 200px; height: auto; border-radius: 32px; border: 1px solid var(--border); }
	.phones .mid { margin-top: 40px; }
	.steps3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; width: 100%; max-width: 1080px; margin-top: 24px; }
	.steps3 figure { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 24px; }
	.steps3 img { width: 100%; max-width: 280px; height: auto; border-radius: 36px; border: 1px solid #1f3652; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4); }
	.steps3 figcaption { display: grid; justify-items: center; gap: 8px; max-width: 280px; }
	.steps3 strong { color: #f2f7fa; font-size: 20px; font-weight: 700; }
	.steps3 figcaption p { margin: 0; color: #9db0c2; font-size: 15px; }
	@media (max-width: 900px) { .steps3 { grid-template-columns: 1fr; } }
	.platforms { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
	.plat { width: 200px; min-height: 228px; align-items: center; text-align: center; gap: 8px; border-radius: 20px; padding: 24px; }
	.plat .btn { margin-top: auto; }
	@media (max-width: 900px) { .grid3 { grid-template-columns: 1fr; } }
	@media (max-width: 760px) { .phones .mid { display: none; } .phones img { width: 40vw; } }
</style>
