---
import '../styles/theme.css';
interface Props { title: string; description?: string }
const { title, description = 'Free, open-source, ultra-lightweight local file sharing. No internet required.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
	['How it works', `${base}/#how`],
	['Features', `${base}/#features`],
	['Platforms', `${base}/#platforms`],
	['Docs', `${base}/docs/`],
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title === 'dropumi' ? 'dropumi: local file sharing, no internet' : `${title} · dropumi`}</title>
		<meta name="description" content={description} />
		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<script is:inline>document.documentElement.classList.add('js')</script>
	</head>
	<body>
		<header class="nav">
			<a href={`${base}/`} class="brand"><img src={`${base}/images/logo.svg`} alt="dropumi" height="34" /></a>
			<nav id="menu">{links.map(([l, h]) => <a href={h}>{l}</a>)}<a class="gh-m" href="https://github.com/dropumi/dropumi">GitHub</a></nav>
			<button class="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
			<a class="gh" href="https://github.com/dropumi/dropumi"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>Star on GitHub</a>
		</header>
		<slot />
		<footer class="footer">
			<img src={`${base}/images/logo-white.svg`} alt="dropumi" height="30" />
			<p>Free and open source. Made for sharing.</p>
			<nav>
				<a href="https://github.com/dropumi/dropumi">GitHub</a>
				<a href={`${base}/docs/`}>Docs</a>
				<a href={`${base}/license/`}>License</a>
				<a href={`${base}/privacy/`}>Privacy</a>
			</nav>
		</footer>
		<script>
			const bar = document.querySelector('header.nav') as HTMLElement;
			const burger = bar.querySelector('.burger') as HTMLButtonElement;
			const setOpen = (o: boolean) => { bar.classList.toggle('open', o); burger.setAttribute('aria-expanded', String(o)); };
			burger.addEventListener('click', () => setOpen(!bar.classList.contains('open')));
			bar.querySelectorAll('#menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
		</script>
		<script>
			const sel = [
				'main section > *', '.card', '.phones img', '.mtext > *', '.hero > *',
				'.content > section', '.body > aside', 'main > header > *',
			].join(',');
			const targets = new Set<HTMLElement>();
			document.querySelectorAll<HTMLElement>(sel).forEach((el) => {
				if (el.closest('.mock') || el.classList.contains('grid3') || el.classList.contains('platforms') || el.classList.contains('phones') || el.classList.contains('mtext')) return;
				targets.add(el);
			});
			targets.forEach((el) => {
				const parent = el.parentElement!;
				const sibs = [...parent.children].filter((c) => targets.has(c as HTMLElement));
				el.style.setProperty('--i', String(Math.max(0, sibs.indexOf(el))));
				el.classList.add('reveal');
			});
			const io = new IntersectionObserver((entries) => {
				entries.forEach((e) => {
					if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
				});
			}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
			targets.forEach((el) => io.observe(el));
		</script>
	</body>
</html>

<style is:global>
	:root { --gutter: max(clamp(20px, 5.5vw, 80px), calc((100vw - 1440px) / 2 + 80px)); }
	* { box-sizing: border-box; }
	body { margin: 0; font-family: var(--font); background: var(--bg); color: var(--text-secondary); line-height: 1.6; }
	a { color: inherit; text-decoration: none; }
	h1, h2, h3 { color: var(--text-primary); margin: 0; letter-spacing: -0.02em; }
	.nav { display: flex; align-items: center; justify-content: space-between; height: 80px; padding: 0 var(--gutter); gap: 24px; }
	.nav nav { display: flex; gap: 36px; font-size: 15px; font-weight: 500; }
	.nav nav a:hover { color: var(--text-primary); }
	.gh { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--border); background: var(--surface); color: var(--text-primary); padding: 10px 20px; border-radius: 999px; font-size: 14px; font-weight: 600; white-space: nowrap; }
	.footer { background: #07121f; color: #9db0c2; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding: 32px var(--gutter); font-size: 14px; }
	.footer p { margin: 0; }
	.footer nav { display: flex; gap: 28px; font-weight: 500; }
	.footer a:hover { color: #fff; }
	.js .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); transition-delay: calc(var(--i, 0) * 90ms); }
	.js .reveal.in { opacity: 1; transform: none; }
	.card, .btn, .gh { transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease, border-color 0.25s ease; }
	.js .card.reveal.in { transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i, 0) * 90ms), transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease; }
	.card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(11, 31, 58, 0.1); border-color: var(--accent); }
	.js .card.reveal.in:hover { transform: translateY(-4px); }
	.btn:hover, .gh:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(11, 31, 58, 0.12); }
	.footer a, .nav nav a { transition: color 0.2s ease; }
	html, body { overflow-x: clip; }
	.burger, .gh-m { display: none; }
	@media (max-width: 760px) {
		.nav { height: 68px; position: relative; }
		.nav .brand img { height: 28px; width: auto; }
		.gh { display: none; }
		.burger { display: grid; gap: 5px; align-content: center; width: 44px; height: 44px; margin-left: auto; padding: 0 11px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); cursor: pointer; }
		.burger span { display: block; height: 2px; border-radius: 2px; background: var(--text-primary); transition: transform 0.25s ease, opacity 0.2s ease; }
		.nav.open .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
		.nav.open .burger span:nth-child(2) { opacity: 0; }
		.nav.open .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
		.nav nav { display: none; position: absolute; top: 68px; left: 16px; right: 16px; z-index: 20; flex-direction: column; gap: 0; padding: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: 18px; box-shadow: 0 20px 40px rgba(11, 31, 58, 0.14); }
		.nav.open nav { display: flex; }
		.nav nav a { padding: 14px 16px; border-radius: 12px; font-size: 16px; }
		.nav nav a:hover { background: var(--accent-soft); }
		.gh-m { display: block; border-top: 1px solid var(--border); margin-top: 4px; }
		.footer { flex-direction: column; text-align: center; gap: 16px; }
		.footer nav { gap: 20px; flex-wrap: wrap; justify-content: center; }
	}
	@media (prefers-reduced-motion: reduce) {
		.js .reveal { opacity: 1; transform: none; transition: none; }
		.card:hover, .js .card.reveal.in:hover, .btn:hover, .gh:hover { transform: none; }
	}
</style>
