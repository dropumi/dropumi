# SPDX-License-Identifier: MPL-2.0
# Minimum OS versions of the Rust slices in DropumiFFI.xcframework. They
# match apps/apple/DropumiKit/Package.swift. The apps set their own, higher
# deployment targets (27.0); these lower minimums only let CI build and test
# the core package on the macOS of its hosted runners. Not a support claim.
IPHONEOS_DEPLOYMENT_TARGET=17.0
MACOSX_DEPLOYMENT_TARGET=14.0
